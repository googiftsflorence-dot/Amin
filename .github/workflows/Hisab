<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>হিসাব খাতা — Amin's Finance Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Tiro+Bangla:ital@0;1&family=DM+Mono:wght@400;500&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:#f5f0e8; --paper:#fffef9; --ink:#1a1207; --ink-soft:#5c4a2a;
    --business:#7b3f00; --business-light:#fff3e0; --business-border:#c8894a;
    --personal:#1a4a2e; --personal-light:#e8f5ee; --personal-border:#4a9a6a;
    --red:#c0392b; --green:#27ae60; --line:#ddd5c0; --shadow:rgba(90,60,20,0.10);
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:var(--bg);font-family:'Tiro Bangla',serif;color:var(--ink);min-height:100vh;padding:0 0 80px 0;
    background-image:repeating-linear-gradient(0deg,transparent,transparent 31px,var(--line) 31px,var(--line) 32px);}

  header{background:var(--ink);color:#f5ead2;padding:22px 24px 18px;text-align:center;border-bottom:4px solid var(--business-border);}
  header h1{font-family:'Playfair Display',serif;font-size:1.7rem;letter-spacing:.03em;margin-bottom:2px;}
  header p{font-family:'DM Mono',monospace;font-size:.72rem;opacity:.55;letter-spacing:.12em;text-transform:uppercase;}
  .date-badge{font-family:'DM Mono',monospace;font-size:.68rem;background:var(--business-border);color:#fff;padding:2px 10px;border-radius:20px;display:inline-block;margin-top:8px;letter-spacing:.08em;}

  .nav-tabs{display:grid;grid-template-columns:1fr 1fr;background:var(--paper);border-bottom:2px solid var(--line);}
  .nav-tab{padding:13px 8px;text-align:center;cursor:pointer;font-family:'DM Mono',monospace;font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;color:var(--ink-soft);border-right:1px solid var(--line);transition:all .15s;}
  .nav-tab:last-child{border-right:none;}
  .nav-tab.active{background:var(--ink);color:#f5ead2;}

  .summary{display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:2px solid var(--line);}
  .sum-card{padding:18px 14px 14px;text-align:center;border-right:1px solid var(--line);background:var(--paper);}
  .sum-card:last-child{border-right:none;}
  .sum-label{font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.14em;opacity:.55;margin-bottom:5px;}
  .sum-amount{font-family:'DM Mono',monospace;font-size:1.25rem;font-weight:500;}
  .sum-card.business .sum-amount{color:var(--business);}
  .sum-card.personal .sum-amount{color:var(--personal);}
  .sum-tag{font-size:.62rem;margin-top:3px;opacity:.5;}

  .form-section{background:var(--paper);border:1.5px solid var(--line);border-radius:3px;margin:20px 16px 0;box-shadow:0 2px 8px var(--shadow);}
  .form-header{padding:12px 16px 10px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:8px;}
  .form-header span{font-family:'DM Mono',monospace;font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;opacity:.5;}
  .form-body{padding:14px 16px 16px;}

  .type-toggle,.inout-toggle{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:14px;}
  .type-btn,.inout-btn{padding:10px 8px;border:2px solid var(--line);border-radius:3px;cursor:pointer;font-family:'Tiro Bangla',serif;font-size:.88rem;background:var(--bg);transition:all .15s;text-align:center;}
  .type-btn.business.active{background:var(--business-light);border-color:var(--business-border);color:var(--business);font-weight:bold;}
  .type-btn.personal.active{background:var(--personal-light);border-color:var(--personal-border);color:var(--personal);font-weight:bold;}
  .inout-btn.income.active{background:#e8f5ee;border-color:var(--green);color:var(--green);font-weight:bold;}
  .inout-btn.expense.active{background:#fdecea;border-color:var(--red);color:var(--red);font-weight:bold;}

  .row{display:flex;gap:10px;margin-bottom:10px;}
  input,select{width:100%;border:1.5px solid var(--line);background:var(--bg);border-radius:2px;padding:10px 12px;font-family:'Tiro Bangla',serif;font-size:.9rem;color:var(--ink);outline:none;transition:border-color .15s;}
  input:focus,select:focus{border-color:var(--business-border);background:var(--paper);}
  .add-btn{width:100%;padding:13px;background:var(--ink);color:#f5ead2;border:none;border-radius:3px;font-family:'Tiro Bangla',serif;font-size:1rem;cursor:pointer;transition:background .15s;margin-top:4px;}
  .add-btn:hover{background:#2d1f0a;}

  .filter-bar{display:flex;margin:20px 16px 0;border:1.5px solid var(--line);border-radius:3px;overflow:hidden;background:var(--paper);}
  .filter-tab{flex:1;padding:10px 4px;text-align:center;cursor:pointer;font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.08em;border-right:1px solid var(--line);transition:all .15s;color:var(--ink-soft);}
  .filter-tab:last-child{border-right:none;}
  .filter-tab.active{background:var(--ink);color:#f5ead2;}

  .ledger{margin:14px 16px 0;}
  .ledger-group-label{font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.16em;color:var(--ink-soft);opacity:.5;padding:8px 0 4px;}
  .entry{background:var(--paper);border:1.5px solid var(--line);border-left:4px solid transparent;border-radius:2px;margin-bottom:8px;padding:12px 14px;display:flex;align-items:center;gap:12px;box-shadow:0 1px 4px var(--shadow);animation:slideIn .2s ease;}
  @keyframes slideIn{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:translateY(0);}}
  .entry.business{border-left-color:var(--business-border);}
  .entry.personal{border-left-color:var(--personal-border);}
  .entry-icon{font-size:1.3rem;flex-shrink:0;width:32px;text-align:center;}
  .entry-info{flex:1;min-width:0;}
  .entry-desc{font-size:.93rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .entry-meta{font-family:'DM Mono',monospace;font-size:.6rem;opacity:.45;margin-top:2px;}
  .entry-amount{font-family:'DM Mono',monospace;font-size:1rem;font-weight:500;text-align:right;flex-shrink:0;}
  .entry-amount.income{color:var(--green);}
  .entry-amount.expense{color:var(--red);}
  .entry-del{background:none;border:none;cursor:pointer;font-size:.75rem;opacity:.25;padding:4px;transition:opacity .15s;flex-shrink:0;}
  .entry-del:hover{opacity:.7;}
  .empty-state{text-align:center;padding:50px 20px;color:var(--ink-soft);opacity:.4;font-size:.95rem;line-height:2;}
  .tag-chip{font-family:'DM Mono',monospace;font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;padding:2px 6px;border-radius:2px;display:inline-block;margin-left:4px;vertical-align:middle;}
  .tag-chip.business{background:var(--business-light);color:var(--business);}
  .tag-chip.personal{background:var(--personal-light);color:var(--personal);}

  /* REPORT */
  .report-section{margin:0 16px;}
  .month-picker{display:flex;align-items:center;justify-content:space-between;background:var(--paper);border:1.5px solid var(--line);border-radius:3px;margin:20px 0 0;padding:12px 16px;}
  .month-nav-btn{background:none;border:1.5px solid var(--line);border-radius:3px;width:36px;height:36px;cursor:pointer;font-size:1rem;display:flex;align-items:center;justify-content:center;transition:all .15s;color:var(--ink);}
  .month-nav-btn:hover{background:var(--ink);color:#f5ead2;}
  .month-label{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;}

  .report-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px;}
  .report-card{background:var(--paper);border:1.5px solid var(--line);border-radius:3px;padding:14px 14px 12px;position:relative;overflow:hidden;}
  .report-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;}
  .report-card.b-income::before{background:var(--green);}
  .report-card.b-expense::before{background:var(--red);}
  .report-card.p-income::before{background:var(--personal-border);}
  .report-card.p-expense::before{background:#e67e22;}
  .rc-label{font-family:'DM Mono',monospace;font-size:.58rem;text-transform:uppercase;letter-spacing:.12em;opacity:.5;margin-bottom:4px;}
  .rc-amount{font-family:'DM Mono',monospace;font-size:1.1rem;font-weight:500;}
  .rc-amount.income{color:var(--green);}
  .rc-amount.expense{color:var(--red);}
  .rc-sub{font-size:.68rem;opacity:.45;margin-top:2px;}

  .net-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px;}
  .net-card{background:var(--paper);border:2px solid var(--line);border-radius:3px;padding:14px;text-align:center;}
  .net-card.business{border-color:var(--business-border);background:var(--business-light);}
  .net-card.personal{border-color:var(--personal-border);background:var(--personal-light);}
  .net-title{font-family:'DM Mono',monospace;font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;opacity:.6;margin-bottom:6px;}
  .net-amount{font-family:'DM Mono',monospace;font-size:1.3rem;font-weight:500;}

  .chart-box{background:var(--paper);border:1.5px solid var(--line);border-radius:3px;margin-top:10px;padding:14px 14px 10px;}
  .chart-title{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;opacity:.5;margin-bottom:12px;}
  .bar-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
  .bar-label{font-size:.75rem;width:72px;flex-shrink:0;opacity:.7;}
  .bar-track{flex:1;height:10px;background:var(--bg);border-radius:2px;overflow:hidden;border:1px solid var(--line);}
  .bar-fill{height:100%;border-radius:2px;transition:width .5s ease;}
  .bar-val{font-family:'DM Mono',monospace;font-size:.68rem;width:64px;text-align:right;flex-shrink:0;opacity:.75;}

  .history-box{background:var(--paper);border:1.5px solid var(--line);border-radius:3px;margin-top:10px;overflow:hidden;}
  .history-header{padding:10px 14px;border-bottom:1px solid var(--line);font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;opacity:.5;}
  .history-row{display:grid;grid-template-columns:1fr auto auto auto;padding:10px 14px;border-bottom:1px solid var(--line);align-items:center;gap:8px;cursor:pointer;transition:background .1s;}
  .history-row:last-child{border-bottom:none;}
  .history-row:hover{background:var(--bg);}
  .history-month{font-size:.88rem;}
  .history-b,.history-p,.history-net{font-family:'DM Mono',monospace;font-size:.7rem;text-align:right;}

  /* BACKUP/RESTORE */
  .backup-box{background:var(--paper);border:1.5px solid var(--line);border-radius:3px;margin:14px 16px 0;padding:14px 16px;}
  .backup-title{font-family:'DM Mono',monospace;font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;opacity:.5;margin-bottom:10px;}
  .backup-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px;}
  .backup-btn{padding:10px;border:1.5px solid var(--line);border-radius:3px;cursor:pointer;font-family:'Tiro Bangla',serif;font-size:.82rem;background:var(--bg);transition:all .15s;text-align:center;}
  .backup-btn.export{border-color:var(--personal-border);color:var(--personal);}
  .backup-btn.import{border-color:var(--business-border);color:var(--business);}
  .backup-btn:hover{opacity:.8;}

  .snack{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(60px);background:var(--ink);color:#f5ead2;padding:10px 22px;border-radius:30px;font-family:'DM Mono',monospace;font-size:.75rem;letter-spacing:.08em;transition:transform .3s ease;z-index:999;white-space:nowrap;}
  .snack.show{transform:translateX(-50%) translateY(0);}
  .hidden{display:none!important;}
</style>
</head>
<body>

<header>
  <h1>📒 হিসাব খাতা</h1>
  <p>Amin's Business & Personal Finance Tracker · Florence</p>
  <div class="date-badge" id="todayDate"></div>
</header>

<div class="nav-tabs">
  <div class="nav-tab active" onclick="showPage('ledger')">📝 লেনদেন</div>
  <div class="nav-tab" onclick="showPage('report')">📊 মাসিক রিপোর্ট</div>
</div>

<div class="summary">
  <div class="sum-card business"><div class="sum-label">🏪 ব্যবসা</div><div class="sum-amount" id="sumBusiness">€0</div><div class="sum-tag">নেট ব্যালেন্স</div></div>
  <div class="sum-card personal"><div class="sum-label">👤 ব্যক্তিগত</div><div class="sum-amount" id="sumPersonal">€0</div><div class="sum-tag">নেট ব্যালেন্স</div></div>
  <div class="sum-card total"><div class="sum-label">💰 মোট</div><div class="sum-amount" id="sumTotal">€0</div><div class="sum-tag">সব মিলিয়ে</div></div>
</div>

<!-- LEDGER PAGE -->
<div id="page-ledger">
  <div class="form-section">
    <div class="form-header"><span>✒️</span><span>নতুন লেনদেন যোগ করুন</span></div>
    <div class="form-body">
      <div class="type-toggle">
        <button class="type-btn business active" onclick="setType('business')">🏪 ব্যবসার টাকা</button>
        <button class="type-btn personal" onclick="setType('personal')">👤 ব্যক্তিগত টাকা</button>
      </div>
      <div class="inout-toggle">
        <button class="inout-btn income active" onclick="setFlow('income')">⬆️ আয় / জমা</button>
        <button class="inout-btn expense" onclick="setFlow('expense')">⬇️ খরচ / বের</button>
      </div>
      <div class="row"><input type="text" id="fDesc" placeholder="বিবরণ লিখুন... (যেমন: চামড়ার ব্যাগ বিক্রি)" /></div>
      <div class="row">
        <input type="number" id="fAmount" placeholder="পরিমাণ (€)" min="0" step="0.01" style="flex:1" />
        <input type="date" id="fDate" style="flex:1" />
      </div>
      <button class="add-btn" onclick="addEntry()">✅ যোগ করুন</button>
    </div>
  </div>

  <div class="filter-bar">
    <div class="filter-tab active" onclick="setFilter('all')">সব</div>
    <div class="filter-tab" onclick="setFilter('business')">🏪 ব্যবসা</div>
    <div class="filter-tab" onclick="setFilter('personal')">👤 ব্যক্তিগত</div>
    <div class="filter-tab" onclick="setFilter('income')">⬆️ আয়</div>
    <div class="filter-tab" onclick="setFilter('expense')">⬇️ খরচ</div>
  </div>
  <div class="ledger" id="ledger"></div>

  <!-- BACKUP -->
  <div class="backup-box">
    <div class="backup-title">💾 ডেটা ব্যাকআপ — হারানো ঠেকাতে নিয়মিত export করুন</div>
    <div class="backup-btns">
      <button class="backup-btn export" onclick="exportData()">📤 Export (সেভ করুন)</button>
      <button class="backup-btn import" onclick="document.getElementById('importFile').click()">📥 Import (ফিরিয়ে আনুন)</button>
    </div>
    <input type="file" id="importFile" accept=".json" style="display:none" onchange="importData(event)" />
  </div>
</div>

<!-- REPORT PAGE -->
<div id="page-report" class="hidden">
  <div class="report-section">
    <div class="month-picker">
      <button class="month-nav-btn" onclick="changeMonth(-1)">◀</button>
      <div class="month-label" id="reportMonthLabel"></div>
      <button class="month-nav-btn" onclick="changeMonth(1)">▶</button>
    </div>

    <div class="report-grid">
      <div class="report-card b-income"><div class="rc-label">🏪 ব্যবসা আয়</div><div class="rc-amount income" id="rBI">€0</div><div class="rc-sub" id="rBI_c">০টি লেনদেন</div></div>
      <div class="report-card b-expense"><div class="rc-label">🏪 ব্যবসা খরচ</div><div class="rc-amount expense" id="rBE">€0</div><div class="rc-sub" id="rBE_c">০টি লেনদেন</div></div>
      <div class="report-card p-income"><div class="rc-label">👤 ব্যক্তিগত আয়</div><div class="rc-amount income" id="rPI">€0</div><div class="rc-sub" id="rPI_c">০টি লেনদেন</div></div>
      <div class="report-card p-expense"><div class="rc-label">👤 ব্যক্তিগত খরচ</div><div class="rc-amount expense" id="rPE">€0</div><div class="rc-sub" id="rPE_c">০টি লেনদেন</div></div>
    </div>

    <div class="net-row">
      <div class="net-card business"><div class="net-title">🏪 ব্যবসা নেট মুনাফা</div><div class="net-amount" id="rBNet">€0</div></div>
      <div class="net-card personal"><div class="net-title">👤 ব্যক্তিগত নেট সঞ্চয়</div><div class="net-amount" id="rPNet">€0</div></div>
    </div>

    <div class="chart-box">
      <div class="chart-title">📊 এই মাসের তুলনামূলক চিত্র</div>
      <div class="bar-row"><div class="bar-label">ব্যবসা আয়</div><div class="bar-track"><div class="bar-fill" id="bar-bi" style="background:var(--green);width:0%"></div></div><div class="bar-val" id="bv-bi">€0</div></div>
      <div class="bar-row"><div class="bar-label">ব্যবসা খরচ</div><div class="bar-track"><div class="bar-fill" id="bar-be" style="background:var(--red);width:0%"></div></div><div class="bar-val" id="bv-be">€0</div></div>
      <div class="bar-row"><div class="bar-label">ব্যক্তি আয়</div><div class="bar-track"><div class="bar-fill" id="bar-pi" style="background:var(--personal-border);width:0%"></div></div><div class="bar-val" id="bv-pi">€0</div></div>
      <div class="bar-row"><div class="bar-label">ব্যক্তি খরচ</div><div class="bar-track"><div class="bar-fill" id="bar-pe" style="background:#e67e22;width:0%"></div></div><div class="bar-val" id="bv-pe">€0</div></div>
    </div>

    <div class="history-box">
      <div class="history-header">📅 গত মাসগুলোর সারসংক্ষেপ — ব্যবসা / ব্যক্তিগত / মোট</div>
      <div id="monthHistory"></div>
    </div>
  </div>
</div>

<div class="snack" id="snack"></div>

<script>
  // ── KEY: একটি unique key ব্যবহার করুন যাতে পুরনো data মিশে না যায়
  const STORAGE_KEY = 'hisab_amin_florence_v1';

  // ── State ──
  let entries = [];
  let currentType = 'business', currentFlow = 'income', currentFilter = 'all', currentPage = 'ledger';
  const now = new Date();
  let reportYear = now.getFullYear(), reportMonth = now.getMonth();
  const BN_MONTHS = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];

  // ── Load from storage (NO sample data) ──
  function loadEntries() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      entries = raw ? JSON.parse(raw) : [];
    } catch(e) {
      entries = [];
    }
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(entries));
    } catch(e) {
      showSnack('⚠️ সেভ করতে সমস্যা হয়েছে');
    }
  }

  // ── Init ──
  document.getElementById('todayDate').textContent = now.toLocaleDateString('bn-BD',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
  document.getElementById('fDate').value = now.toISOString().split('T')[0];
  loadEntries();
  renderAll();

  // ── Page nav ──
  function showPage(p) {
    currentPage = p;
    document.querySelectorAll('.nav-tab').forEach((t,i) => t.classList.toggle('active', i===(p==='ledger'?0:1)));
    document.getElementById('page-ledger').classList.toggle('hidden', p!=='ledger');
    document.getElementById('page-report').classList.toggle('hidden', p!=='report');
    if (p==='report') renderReport();
  }

  // ── Toggles ──
  function setType(t) {
    currentType = t;
    document.querySelectorAll('.type-btn').forEach(b=>b.classList.remove('active'));
    document.querySelector(`.type-btn.${t}`).classList.add('active');
  }
  function setFlow(f) {
    currentFlow = f;
    document.querySelectorAll('.inout-btn').forEach(b=>b.classList.remove('active'));
    document.querySelector(`.inout-btn.${f}`).classList.add('active');
  }
  function setFilter(f) {
    currentFilter = f;
    ['all','business','personal','income','expense'].forEach((v,i)=>{
      document.querySelectorAll('.filter-tab')[i].classList.toggle('active', v===f);
    });
    renderLedger();
  }

  // ── Add entry ──
  function addEntry() {
    const desc   = document.getElementById('fDesc').value.trim();
    const amount = parseFloat(document.getElementById('fAmount').value);
    const date   = document.getElementById('fDate').value;
    if (!desc)              { showSnack('⚠️ বিবরণ লিখুন'); return; }
    if (!amount || amount<=0){ showSnack('⚠️ সঠিক পরিমাণ দিন'); return; }
    if (!date)              { showSnack('⚠️ তারিখ দিন'); return; }

    entries.unshift({ id: Date.now(), type: currentType, flow: currentFlow, desc, amount, date });
    save();
    document.getElementById('fDesc').value = '';
    document.getElementById('fAmount').value = '';
    showSnack('✅ লেনদেন যোগ হয়েছে');
    renderAll();
  }

  // ── Delete ──
  function deleteEntry(id) {
    if (!confirm('এই লেনদেন মুছে ফেলবেন?')) return;
    entries = entries.filter(e => e.id !== id);
    save(); renderAll(); showSnack('🗑️ মুছে ফেলা হয়েছে');
  }

  // ── Export / Import ──
  function exportData() {
    if (!entries.length) { showSnack('⚠️ কোনো ডেটা নেই'); return; }
    const blob = new Blob([JSON.stringify(entries, null, 2)], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    const dateStr = now.toISOString().split('T')[0];
    a.download = `hisab_backup_${dateStr}.json`;
    a.click();
    showSnack('📤 Backup ডাউনলোড হয়েছে');
  }

  function importData(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
      try {
        const imported = JSON.parse(e.target.result);
        if (!Array.isArray(imported)) throw new Error();
        // Merge: নতুন entries যোগ করো, duplicate বাদ দাও
        const existingIds = new Set(entries.map(x => x.id));
        const newOnes = imported.filter(x => !existingIds.has(x.id));
        entries = [...entries, ...newOnes].sort((a,b) => b.id - a.id);
        save(); renderAll();
        showSnack(`✅ ${newOnes.length}টি নতুন লেনদেন import হয়েছে`);
      } catch {
        showSnack('⚠️ ফাইলটি সঠিক নয়');
      }
    };
    reader.readAsText(file);
    event.target.value = '';
  }

  // ── Summary ──
  function renderSummary() {
    const s = (t,f) => entries.filter(e=>e.type===t&&e.flow===f).reduce((a,e)=>a+e.amount,0);
    const bNet = s('business','income') - s('business','expense');
    const pNet = s('personal','income') - s('personal','expense');
    const total = bNet + pNet;
    document.getElementById('sumBusiness').textContent = fmt(bNet);
    document.getElementById('sumPersonal').textContent = fmt(pNet);
    document.getElementById('sumTotal').textContent    = fmt(total);
    document.getElementById('sumBusiness').style.color = bNet<0?'var(--red)':'var(--business)';
    document.getElementById('sumPersonal').style.color = pNet<0?'var(--red)':'var(--personal)';
    document.getElementById('sumTotal').style.color    = total<0?'var(--red)':'var(--ink)';
  }

  // ── Ledger ──
  function renderLedger() {
    let filtered = entries;
    if (currentFilter==='business') filtered = entries.filter(e=>e.type==='business');
    if (currentFilter==='personal') filtered = entries.filter(e=>e.type==='personal');
    if (currentFilter==='income')   filtered = entries.filter(e=>e.flow==='income');
    if (currentFilter==='expense')  filtered = entries.filter(e=>e.flow==='expense');

    const ledger = document.getElementById('ledger');
    if (!filtered.length) {
      ledger.innerHTML = '<div class="empty-state">📭 এখনো কোনো লেনদেন নেই<br>উপরের ফর্মে প্রথম লেনদেন যোগ করুন</div>';
      return;
    }

    const groups = {};
    filtered.forEach(e => { if(!groups[e.date]) groups[e.date]=[]; groups[e.date].push(e); });

    let html = '';
    Object.keys(groups).sort().reverse().forEach(date => {
      const label = new Date(date+'T00:00:00').toLocaleDateString('bn-BD',{day:'numeric',month:'long',year:'numeric'});
      html += `<div class="ledger-group-label">${label}</div>`;
      groups[date].forEach(e => {
        const icon = e.flow==='income' ? (e.type==='business'?'🏪':'👤') : '💸';
        const chip = `<span class="tag-chip ${e.type}">${e.type==='business'?'ব্যবসা':'ব্যক্তিগত'}</span>`;
        const sign = e.flow==='income' ? '+' : '−';
        html += `<div class="entry ${e.type}">
          <div class="entry-icon">${icon}</div>
          <div class="entry-info">
            <div class="entry-desc">${e.desc} ${chip}</div>
            <div class="entry-meta">${e.flow==='income'?'আয়':'খরচ'}</div>
          </div>
          <div class="entry-amount ${e.flow}">${sign}${fmt(e.amount)}</div>
          <button class="entry-del" onclick="deleteEntry(${e.id})">✕</button>
        </div>`;
      });
    });
    ledger.innerHTML = html;
  }

  // ── Report ──
  function changeMonth(dir) {
    reportMonth += dir;
    if (reportMonth>11) { reportMonth=0; reportYear++; }
    if (reportMonth<0)  { reportMonth=11; reportYear--; }
    renderReport();
  }

  function getMonthEntries(y,m) {
    const prefix = `${y}-${String(m+1).padStart(2,'0')}`;
    return entries.filter(e=>e.date.startsWith(prefix));
  }

  function renderReport() {
    document.getElementById('reportMonthLabel').textContent = `${BN_MONTHS[reportMonth]} ${reportYear}`;
    const me = getMonthEntries(reportYear, reportMonth);
    const s  = (t,f) => me.filter(e=>e.type===t&&e.flow===f).reduce((a,e)=>a+e.amount,0);
    const c  = (t,f) => me.filter(e=>e.type===t&&e.flow===f).length;
    const bi=s('business','income'), be=s('business','expense');
    const pi=s('personal','income'), pe=s('personal','expense');
    const bNet=bi-be, pNet=pi-pe;

    document.getElementById('rBI').textContent = '+'+fmt(bi);
    document.getElementById('rBE').textContent = '−'+fmt(be);
    document.getElementById('rPI').textContent = '+'+fmt(pi);
    document.getElementById('rPE').textContent = '−'+fmt(pe);
    document.getElementById('rBI_c').textContent = c('business','income')+'টি লেনদেন';
    document.getElementById('rBE_c').textContent = c('business','expense')+'টি লেনদেন';
    document.getElementById('rPI_c').textContent = c('personal','income')+'টি লেনদেন';
    document.getElementById('rPE_c').textContent = c('personal','expense')+'টি লেনদেন';

    const bEl=document.getElementById('rBNet'), pEl=document.getElementById('rPNet');
    bEl.textContent = (bNet>=0?'+':'−')+fmt(bNet);
    pEl.textContent = (pNet>=0?'+':'−')+fmt(pNet);
    bEl.style.color = bNet<0?'var(--red)':'var(--business)';
    pEl.style.color = pNet<0?'var(--red)':'var(--personal)';

    const maxV = Math.max(bi,be,pi,pe,1);
    const sb = (id,vId,val) => {
      document.getElementById(id).style.width = (val/maxV*100)+'%';
      document.getElementById(vId).textContent = fmt(val);
    };
    sb('bar-bi','bv-bi',bi); sb('bar-be','bv-be',be);
    sb('bar-pi','bv-pi',pi); sb('bar-pe','bv-pe',pe);

    // History: last 6 months with data
    let histHtml = '';
    let shown = 0;
    for (let i=0; i<24 && shown<6; i++) {
      let m=reportMonth-i, y=reportYear;
      while (m<0) { m+=12; y--; }
      const me2 = getMonthEntries(y,m);
      if (!me2.length) continue;
      shown++;
      const s2=(t,f)=>me2.filter(e=>e.type===t&&e.flow===f).reduce((a,e)=>a+e.amount,0);
      const bN=s2('business','income')-s2('business','expense');
      const pN=s2('personal','income')-s2('personal','expense');
      const tot=bN+pN;
      const isActive=(y===reportYear&&m===reportMonth);
      histHtml+=`<div class="history-row" onclick="jumpToMonth(${y},${m})" style="${isActive?'background:var(--bg);':''}">
        <div class="history-month" style="${isActive?'font-weight:700':''}">
          ${BN_MONTHS[m]} ${y}${isActive?' ◀':''}
        </div>
        <div class="history-b" style="color:${bN<0?'var(--red)':'var(--business)'}">${bN>=0?'+':'−'}${fmt(bN)}</div>
        <div class="history-p" style="color:${pN<0?'var(--red)':'var(--personal)'}">${pN>=0?'+':'−'}${fmt(pN)}</div>
        <div class="history-net" style="color:${tot<0?'var(--red)':'var(--ink)'};font-weight:600">${tot>=0?'+':'−'}${fmt(tot)}</div>
      </div>`;
    }
    document.getElementById('monthHistory').innerHTML = histHtml ||
      '<div style="padding:20px;text-align:center;opacity:.4;font-size:.85rem">এই মাসে কোনো লেনদেন নেই</div>';
  }

  function jumpToMonth(y,m) { reportYear=y; reportMonth=m; renderReport(); }

  function renderAll() { renderSummary(); renderLedger(); if(currentPage==='report') renderReport(); }

  function fmt(n) { return '€'+Math.abs(n).toLocaleString('en-DE',{minimumFractionDigits:2,maximumFractionDigits:2}); }

  function showSnack(msg) {
    const s=document.getElementById('snack');
    s.textContent=msg; s.classList.add('show');
    setTimeout(()=>s.classList.remove('show'),2400);
  }
</script>
